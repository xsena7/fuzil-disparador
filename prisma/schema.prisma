generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Usuários, workspaces e sessões
// ---------------------------------------------------------------------------

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  isSuperAdmin Boolean         @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  memberships  Membership[]
  sessions     Session[]
  tokens       PasswordToken[]
}

enum TokenPurpose {
  INVITE
  RESET
}

// Link de "criar senha" (convite) ou "redefinir senha" enviado por e-mail
model PasswordToken {
  id        String       @id // hash sha256 do token
  userId    String
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id                  String              @id @default(cuid())
  name                String
  // Saldo em créditos (1 crédito = 1 mensagem por padrão)
  creditBalance       Int                 @default(0)
  creditsPerMessage   Int                 @default(1)
  telegramChatId      String?
  // Exclui na Meta qualquer template que for recategorizado para marketing
  autoDeleteMarketing Boolean             @default(false)
  // Envia por e-mail os alertas críticos para donos e admins
  emailAlerts         Boolean             @default(true)
  // Webhooks do Discord por canal: { campaigns, templates, quality, limits, general }
  discordWebhooks     Json?
  // Conta bloqueada pelo admin da plataforma: ninguém entra e nada é disparado
  blockedAt           DateTime?
  blockedReason       String?
  // Cobrança no relatório do cliente: chaves Pix [{ id, key, name, bank }] e valor padrão por mensagem enviada (R$)
  pixKeys             Json?
  reportPrice         Float?
  // Chave secreta (App Secret) usada sozinha em toda BM nova conectada manualmente (criptografada)
  defaultAppSecretEnc String?
  createdAt           DateTime            @default(now())
  memberships         Membership[]
  creditTxs           CreditTransaction[]
  businesses          BusinessManager[]
  wabas               WhatsAppAccount[]
  groups              BmGroup[]
  templates           Template[]
  campaigns           Campaign[]
  contacts            Contact[]
  alerts              Alert[]
  inbound             InboundMessage[]
  blueprints          TemplateBlueprint[]
  campaignFolders     CampaignFolder[]
  conversations       Conversation[]
  quickReplies        QuickReply[]
  funnels             Funnel[]
  externalLinks       ExternalLink[]
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        Role      @default(MEMBER)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Session {
  id          String   @id // hash sha256 do token
  userId      String
  workspaceId String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum CreditTxType {
  TOPUP
  DEBIT
  REFUND
  ADJUST
}

model CreditTransaction {
  id           String       @id @default(cuid())
  workspaceId  String
  type         CreditTxType
  amount       Int // positivo = entrada, negativo = saída
  balanceAfter Int
  description  String
  campaignId   String?
  createdById  String?
  createdAt    DateTime     @default(now())
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// ---------------------------------------------------------------------------
// Meta: BMs, WABAs e números
// ---------------------------------------------------------------------------

model BusinessManager {
  id                 String            @id @default(cuid())
  workspaceId        String
  metaBusinessId     String?
  name               String
  // Limite de mensagens do portfólio (ex.: TIER_250, TIER_2K, TIER_10K, TIER_100K, TIER_UNLIMITED)
  messagingLimitTier String?
  verificationStatus String?
  notes              String?
  // Quando a BM bateu o limite de 24h (para avisar uma vez e avisar quando voltar)
  limitFullSince     DateTime?
  // Primeiro disparo da BM: só depois dele ela pode ir sozinha para o grupo "BMs com problema"
  firstSentAt        DateTime?
  problemReason      String?
  problemFix         String?
  problemAt          DateTime?
  // Grupos em que ela estava antes de ir para "BMs com problema" (para devolver)
  problemPrevGroups  String[]          @default([])
  // Problema que o cliente marcou como resolvido: não move de novo pelo mesmo motivo até ele sumir
  problemIgnored     String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wabas              WhatsAppAccount[]
  groups             BmGroupMember[]

  @@unique([workspaceId, metaBusinessId])
}

enum ConnectionType {
  CLOUD_API
  COEXISTENCE
  MANUAL
}

model WhatsAppAccount {
  id                String               @id @default(cuid())
  workspaceId       String
  businessId        String
  wabaId            String
  name              String
  connectionType    ConnectionType       @default(MANUAL)
  // Token criptografado (AES-256-GCM). Se nulo, usa META_SYSTEM_USER_TOKEN
  accessTokenEnc    String?
  // App Secret do app da própria BM (conexão manual): valida os webhooks que esse app manda (respostas, status)
  appSecretEnc      String?
  // Diagnóstico do webhook: último evento aceito e último recusado (assinatura não confere)
  webhookLastAt     DateTime?
  webhookRejectedAt DateTime?
  currency          String?
  timezoneId        String?
  reviewStatus      String?
  hasPaymentMethod  Boolean? // null = não deu para saber
  healthIssues      Json? // problemas que a Meta aponta e impedem/limitam o envio
  status            String? // ex.: ACTIVE, DISABLED, BANNED
  webhookSubscribed Boolean              @default(false)
  lastSyncedAt      DateTime?
  lastSyncError     String?
  createdAt         DateTime             @default(now())
  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business          BusinessManager      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  phones            PhoneNumber[]
  templates         Template[]
  deployments       TemplateDeployment[]

  @@unique([workspaceId, wabaId])
}

model PhoneNumber {
  id                 String              @id @default(cuid())
  wabaId             String
  phoneNumberId      String              @unique
  displayPhoneNumber String
  verifiedName       String?
  qualityRating      String? // GREEN, YELLOW, RED, UNKNOWN
  messagingLimitTier String?
  status             String? // CONNECTED, FLAGGED, RESTRICTED, BANNED...
  nameStatus         String?
  throughputLevel    String?
  isCoexistence      Boolean             @default(false)
  // Permite tirar o número do rodízio sem desconectar
  enabled            Boolean             @default(true)
  // Preenchido quando o número não serve para disparo (número de teste da Meta, não registrado...)
  invalidReason      String?
  isDefault          Boolean             @default(false)
  lastSyncedAt       DateTime?
  createdAt          DateTime            @default(now())
  waba               WhatsAppAccount     @relation(fields: [wabaId], references: [id], onDelete: Cascade)
  recipients         CampaignRecipient[]
  inbound            InboundMessage[]
  conversations      Conversation[]
}

model BmGroup {
  id          String              @id @default(cuid())
  workspaceId String
  name        String
  description String?
  // "PROBLEMS" = grupo automático das BMs com problema (não entra em campanha)
  system      String?
  // Cor da etiqueta do grupo (nome da cor: red, amber, emerald, sky, violet, pink, orange, zinc)
  color       String?
  createdAt   DateTime            @default(now())
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     BmGroupMember[]
  campaigns   Campaign[]
  blueprints  TemplateBlueprint[]
}

model BmGroupMember {
  groupId    String
  businessId String
  group      BmGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  business   BusinessManager @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([groupId, businessId])
}

// ---------------------------------------------------------------------------
// Templates
// ---------------------------------------------------------------------------

model Template {
  id               String          @id @default(cuid())
  workspaceId      String
  wabaId           String
  metaTemplateId   String?
  name             String
  language         String
  category         String // UTILITY, MARKETING, AUTHENTICATION
  previousCategory String?
  status           String // APPROVED, PENDING, REJECTED, PAUSED, DISABLED...
  rejectedReason   String?
  qualityScore     String?
  components       Json
  submittedAt      DateTime? // quando o Fuzil mandou esse template para a Meta
  lastSyncedAt     DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  waba             WhatsAppAccount @relation(fields: [wabaId], references: [id], onDelete: Cascade)

  @@unique([wabaId, name, language])
  @@index([workspaceId, name, language])
}

// ---------------------------------------------------------------------------
// Alertas
// ---------------------------------------------------------------------------

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model Alert {
  id          String        @id @default(cuid())
  workspaceId String
  type        String // TEMPLATE_RECATEGORIZED, TEMPLATE_REJECTED, TEMPLATE_PAUSED, QUALITY_CHANGE, LIMIT_CHANGE, NUMBER_STATUS, CAMPAIGN_PAUSED, LOW_BALANCE
  severity    AlertSeverity @default(INFO)
  title       String
  message     String
  data        Json?
  readAt      DateTime?
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, readAt])
}

// ---------------------------------------------------------------------------
// Contatos e campanhas
// ---------------------------------------------------------------------------

model Contact {
  id          String    @id @default(cuid())
  workspaceId String
  phone       String // somente dígitos, com DDI
  name        String?
  email       String?
  optedOut    Boolean   @default(false)
  optedOutAt  DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, phone])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

model Campaign {
  id                 String              @id @default(cuid())
  workspaceId        String
  name               String
  status             CampaignStatus      @default(DRAFT)
  groupId            String?
  templateName       String?
  templateLanguage   String?
  // { "body": [{ "type": "field", "value": "firstName" } | { "type": "fixed", "value": "..." }], "header": [...] }
  variableMapping    Json?
  headerMediaUrl     String?
  headerMediaType    String? // IMAGE, VIDEO, DOCUMENT
  headerMediaName    String?
  // URL de destino do botão (o redirecionador manda o clique pra cá)
  buttonUrl          String?
  // Mensagens por segundo por número (0 = automático)
  ratePerSecond      Int                 @default(0)
  // Velocidade TOTAL da campanha (mensagens por segundo somando todos os números). Nulo = jeito antigo (por número)
  totalRatePerSecond Int?
  // Não usar números com qualidade vermelha
  skipRedQuality     Boolean             @default(true)
  // Números retirados desta campanha por erro grave (ids de PhoneNumber)
  excludedSenders    String[]            @default([])
  creditsRefunded    Boolean             @default(false)
  scheduledAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  pausedReason       String?
  audienceFileName   String?
  audienceStats      Json?
  // Pasta (gaveta) onde a campanha foi guardada; nulo = lista principal
  folderId           String?
  // Resposta automática: enviada uma vez quando o contato responde a esta campanha
  autoReplyEnabled   Boolean             @default(false)
  autoReplyText      String?
  autoReplyMediaUrl  String?
  autoReplyMediaType String? // IMAGE, VIDEO, AUDIO, DOCUMENT
  autoReplyMediaName String?
  // Campanha interna de um funil de aquecimento (não aparece na lista e nunca é concluída)
  funnelId           String?
  // Qual passo do funil essa campanha envia ("code", "done" ou o id do passo)
  funnelStep         String?
  // Categoria exigida do template: UTILITY (padrão) ou AUTHENTICATION (código de confirmação)
  templateCategory   String              @default("UTILITY")
  // Origem dos disparos: GROUP (grupo de BMs) ou BM (uma BM só)
  scope              String              @default("GROUP")
  // Relatório do cliente: valor por mensagem só desta campanha (vazio = o padrão da conta) e link público
  reportPrice        Float?
  // Qual chave Pix aparece no relatório desta campanha (id da chave; "ALL" = todas; vazio = a primeira)
  reportPixKeyId     String?
  // Números ajustados à mão para o relatório do cliente: { total, sent, read, clicked, replied, failed, noWa } (vazio = números reais)
  reportOverrides    Json?
  shareToken         String?             @unique
  // O link do cliente some sozinho depois de 12h
  shareExpiresAt     DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group              BmGroup?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  folder             CampaignFolder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  funnel             Funnel?             @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  recipients         CampaignRecipient[]
  clicks             LinkClick[]

  @@unique([funnelId, funnelStep])
  @@index([workspaceId, status])
}

enum RecipientStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

model CampaignRecipient {
  id              String          @id @default(cuid())
  campaignId      String
  phone           String
  name            String?
  data            Json // linha da planilha (para variáveis)
  status          RecipientStatus @default(PENDING)
  senderId        String?
  wamid           String?         @unique
  errorCode       Int?
  errorTitle      String?
  errorDetail     String?
  clickToken      String          @unique
  clickCount      Int             @default(0)
  firstClickAt    DateTime?
  repliedAt       DateTime?
  optedOutAt      DateTime?
  creditsCharged  Int             @default(0)
  autoReplySentAt DateTime?
  attempts        Int             @default(0)
  // Não tenta de novo antes disso (limite de velocidade da Meta)
  retryAt         DateTime?
  queuedAt        DateTime?
  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  failedAt        DateTime?
  createdAt       DateTime        @default(now())
  campaign        Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender          PhoneNumber?    @relation(fields: [senderId], references: [id], onDelete: SetNull)
  clicks          LinkClick[]

  @@unique([campaignId, phone])
  @@index([campaignId, status])
  @@index([phone, sentAt])
  @@index([sentAt])
  @@index([status, queuedAt])
}

model LinkClick {
  id          String            @id @default(cuid())
  campaignId  String
  recipientId String
  ip          String?
  userAgent   String?
  isBot       Boolean           @default(false)
  createdAt   DateTime          @default(now())
  campaign    Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient   CampaignRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([recipientId])
}

model InboundMessage {
  id          String       @id @default(cuid())
  workspaceId String
  phoneId     String?
  from        String
  wamid       String       @unique
  type        String
  text        String?
  payload     Json
  recipientId String?
  receivedAt  DateTime
  createdAt   DateTime     @default(now())
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phone       PhoneNumber? @relation(fields: [phoneId], references: [id], onDelete: SetNull)

  @@index([workspaceId, receivedAt])
  @@index([recipientId])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([processedAt])
}

// ---------------------------------------------------------------------------
// Template padrão: replicado automaticamente em todas as WABAs do escopo
// ---------------------------------------------------------------------------

model TemplateBlueprint {
  id               String               @id @default(cuid())
  workspaceId      String
  // Nulo = todas as BMs da conta
  groupId          String?
  name             String
  language         String
  // UTILITY (padrão) ou AUTHENTICATION (código de confirmação do aquecimento)
  category         String               @default("UTILITY")
  components       Json
  // Arquivo de exemplo da mídia do cabeçalho (obrigatório pela Meta em headers de mídia)
  headerSamplePath String?
  headerSampleMime String?
  active           Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group            BmGroup?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  deployments      TemplateDeployment[]

  @@unique([workspaceId, name, language])
}

enum DeploymentStatus {
  SUBMITTED
  APPROVED
  REJECTED
  RECATEGORIZED_DELETED
  // A Meta já criou como marketing: o texto é que é marketing, trocar o nome não resolve
  MARKETING_ON_CREATE
  ERROR
  // Texto editado depois de rejeitar: sobe de novo com o próximo nome (o antigo segue rejeitado na Meta)
  RETRY
}

model TemplateDeployment {
  id          String            @id @default(cuid())
  blueprintId String
  wabaId      String
  status      DeploymentStatus
  error       String?
  attempts    Int               @default(1)
  // Nome usado nessa WABA. Quando a Meta reclassifica, o nome queima e vira fzl_disp2, fzl_disp3...
  currentName String?
  version     Int               @default(1)
  submittedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  blueprint   TemplateBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  waba        WhatsAppAccount   @relation(fields: [wabaId], references: [id], onDelete: Cascade)

  @@unique([blueprintId, wabaId])
}

// Configurações da plataforma editáveis pelo painel (Admin). Segredos ficam criptografados.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Pastas para organizar campanhas antigas sem precisar excluir
model CampaignFolder {
  id          String     @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime   @default(now())
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]

  @@unique([workspaceId, name])
}

// Erros do sistema (site e worker), também enviados ao Discord da plataforma
model SystemLog {
  id        String   @id @default(cuid())
  level     String // error | warn
  source    String // web | worker | webhook | ...
  message   String
  detail    String?
  path      String?
  digest    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum BugStatus {
  OPEN
  RESOLVED
}

// Bug reportado pelo cliente (botão do bichinho no canto da tela)
model BugReport {
  id            String    @id @default(cuid())
  userId        String?
  userName      String
  userEmail     String
  workspaceId   String?
  workspaceName String
  message       String
  pagePath      String?
  userAgent     String?
  screenshotUrl String?
  // Se o aviso chegou no Discord (e o motivo, se não chegou)
  discordSent   Boolean   @default(false)
  discordError  String?
  status        BugStatus @default(OPEN)
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, createdAt])
}

enum ConversationStatus {
  OPEN // aguardando atendimento
  ATTENDING // alguém está atendendo
  CLOSED // finalizada
}

// Conversa = um contato falando com UM dos nossos números
model Conversation {
  id              String             @id @default(cuid())
  workspaceId     String
  phoneId         String
  contactPhone    String
  contactName     String?
  status          ConversationStatus @default(OPEN)
  unread          Int                @default(0)
  hasInbound      Boolean            @default(false)
  lastMessageAt   DateTime           @default(now())
  lastMessageText String?
  lastDirection   String? // IN | OUT
  lastInboundAt   DateTime? // abre a janela de 24h para mensagem livre
  clickedAt       DateTime? // clicou no botão do disparo (vai para "Em andamento")
  assignedUserId  String?
  closedAt        DateTime?
  createdAt       DateTime           @default(now())
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phone           PhoneNumber        @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  messages        ChatMessage[]

  @@unique([phoneId, contactPhone])
  @@index([workspaceId, lastMessageAt])
  @@index([workspaceId, hasInbound, lastMessageAt])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  workspaceId    String
  direction      String // IN | OUT
  kind           String // text, template, image, audio, video, document, sticker, location, button, reaction, contacts, unknown
  text           String?
  mediaId        String? // id da mídia na Meta (recebida)
  mediaUrl       String? // url pública da mídia que enviamos
  mediaMime      String?
  mediaName      String?
  wamid          String?      @unique
  status         String? // pending, sent, delivered, read, failed
  error          String?
  source         String // CAMPAIGN | AUTO_REPLY | AGENT | CUSTOMER
  campaignId     String?
  senderUserId   String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// Respostas rápidas do chat (atalho "/")
model QuickReply {
  id          String    @id @default(cuid())
  workspaceId String
  shortcut    String
  text        String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, shortcut])
}

// ---------------------------------------------------------------------------
// Aquecimento: landing page + código no WhatsApp + funil com timers
// ---------------------------------------------------------------------------

enum FunnelStatus {
  ACTIVE
  PAUSED
}

model Funnel {
  id               String       @id @default(cuid())
  workspaceId      String
  name             String
  // Endereço público: /v/<slug> (ou o domínio próprio)
  slug             String       @unique
  domain           String?      @unique
  status           FunnelStatus @default(ACTIVE)
  // Grupo de BM que dispara as mensagens do funil
  groupId          String?
  // Textos da landing page: { company, jobTitle, headline, subtitle, about, benefits[], requirements[], cta, color }
  page             Json
  pixelId          String?
  // API de Conversões (CAPI): token criptografado, código de teste e o resultado do último envio
  capiTokenEnc     String?
  capiTestCode     String?
  capiLastOkAt     DateTime?
  capiLastError    String?
  // Perguntas do cadastro final: [{ key, label, type: text|textarea|select, options[], required }]
  formFields       Json
  // Passos depois que a pessoa confirma o número: [{ id, type: wait|send, amount, unit, blueprintId, mapping, onlyIfPending }]
  steps            Json
  // Templates padrão do código e da mensagem de cadastro recebido
  codeBlueprintId  String?
  doneBlueprintId  String?
  // JOBS = landing de vagas; LINKS = login por WhatsApp do gerador de links (sem landing)
  kind             String       @default("JOBS")
  // LINKS: aviso de "novo acesso" com os botões Fui eu / Não fui eu
  loginBlueprintId String?
  // Janela de envio dos passos (hora de Brasília)
  sendFrom         Int          @default(8)
  sendTo           Int          @default(21)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads            Lead[]
  campaigns        Campaign[]
}

enum LeadStatus {
  CODE_SENT // preencheu o formulário, falta confirmar o código
  VERIFIED // confirmou o WhatsApp, está no funil
  COMPLETED // respondeu o cadastro final
  STOPPED // tirado do funil pelo dono: não recebe mais nada
}

model Lead {
  id            String         @id @default(cuid())
  funnelId      String
  workspaceId   String
  name          String
  phone         String
  email         String?
  // Vaga que a pessoa escolheu na página
  job           String?
  status        LeadStatus     @default(CODE_SENT)
  codeHash      String?
  codeExpiresAt DateTime?
  codeAttempts  Int            @default(0)
  codeSends     Int            @default(0)
  lastCodeAt    DateTime?
  verifiedAt    DateTime?
  stoppedAt     DateTime?
  // Link do cadastro final
  formToken     String         @unique
  answers       Json?
  answeredAt    DateTime?
  // Próximo passo do funil e quando ele roda
  stepIndex     Int            @default(0)
  nextStepAt    DateTime?
  utm           Json?
  ip            String?
  createdAt     DateTime       @default(now())
  funnel        Funnel         @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  linkSessions  LinkSession[]
  links         ExternalLink[]

  @@unique([funnelId, phone])
  @@index([nextStepAt])
  @@index([funnelId, createdAt])
}

// Link do botão para disparar por OUTRA plataforma com o mesmo template aprovado:
// na variável do botão vai só o código, e o redirecionador manda para a url daqui.
// Criado no site público (sem login, com a senha de acesso do Admin); quem criou edita pelo link secreto.
model ExternalLink {
  id          String     @id @default(cuid())
  workspaceId String?
  name        String
  code        String     @unique
  url         String
  // sha256 da chave do link de gerenciamento (a chave em si só quem criou tem)
  editKeyHash String?    @unique
  creatorIp   String?
  clicks      Int        @default(0)
  lastClickAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Dono do link (cliente logado pelo WhatsApp no gerador de links)
  leadId      String?
  lead        Lead?      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([leadId])
}

// Login salvo no navegador do gerador de links. Vale só no mesmo IP; IP novo pede código de novo.
model LinkSession {
  id         String    @id @default(cuid())
  leadId     String
  tokenHash  String    @unique
  ip         String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  // Último aviso de "novo acesso" mandado no WhatsApp
  alertedAt  DateTime?
  revokedAt  DateTime?
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}
