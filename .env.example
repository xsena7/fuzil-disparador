# ---------- Domínios (produção) ----------
# Painel e domínio dos links (podem ser subdomínios do mesmo domínio)
APP_DOMAIN=app.fuzildisparador.com.br
LINK_DOMAIN=go.fuzildisparador.com.br
POSTGRES_PASSWORD=troque-esta-senha

# ---------- App ----------
# URL pública do painel (com https em produção)
APP_URL=http://localhost:3000
# Domínio usado nos botões de link (sem https://). Em produção, igual ao LINK_DOMAIN
# O template na Meta deve ser aprovado com a URL https://SEU_DOMINIO/{{1}}
REDIRECT_DOMAIN=localhost:3000
DATABASE_URL=postgresql://fuzil:fuzil@localhost:5432/fuzil
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=
# Libera o cadastro público (o primeiro usuário sempre pode se cadastrar e vira admin)
ALLOW_SIGNUP=false
# Diretório onde ficam as mídias enviadas (imagens do cabeçalho)
UPLOAD_DIR=./uploads

# ---------- Meta / Tech Provider ----------
META_APP_ID=
META_APP_SECRET=
# Configuração do Embedded Signup (Facebook Login for Business)
META_CONFIG_ID=
# Token de System User do Tech Provider (fallback quando a WABA não tem token próprio)
META_SYSTEM_USER_TOKEN=
META_GRAPH_VERSION=v23.0
# Pode apontar para um mock em testes
META_GRAPH_URL=https://graph.facebook.com
# Token que você define e cola no painel da Meta ao configurar o webhook
META_WEBHOOK_VERIFY_TOKEN=
# PIN de 6 dígitos usado ao registrar números na Cloud API
META_REGISTER_PIN=123456

